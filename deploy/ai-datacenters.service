[Unit]
Description=ai-datacenters web app (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/ai-datacenters
ExecStart=%h/.local/bin/uv run uvicorn ai_datacenters.web:app --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=5
# Required: XAI_API_KEY=xai-... must be in this file (chmod 600).
EnvironmentFile=%h/ai-datacenters/.env

[Install]
WantedBy=default.target
